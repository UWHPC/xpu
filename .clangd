If:
  PathMatch: .*\.(cpp|cc|cxx)

CompileFlags:
  CompilationDatabase: build-clangd-cpp
  Add:
    - --gcc-install-dir=/usr/lib/gcc/x86_64-linux-gnu/15

---

If:
  PathExclude: .*\.(cpp|cc|cxx)

CompileFlags:
  CompilationDatabase: build-clangd-cuda
  Remove:
    - -forward-unknown-to-host-compiler
    - -ccbin=*
    - -arch=*
    - -Xcompiler=*
  Add:
    - -xcuda
    - --cuda-host-only
    - --gcc-install-dir=/usr/lib/gcc/x86_64-linux-gnu/15
    - -std=c++23
